{
  "name": "yapbook-streamlit-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "c8 --all --include \"src/**/*.mjs\" --include \"src/**/*.jsx\" --extension .mjs --extension .jsx --reporter=json --reporter=json-summary --reports-dir=test-output/quality-coverage node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-output/node-tests.xml tests/*.test.mjs",
    "test:browser": "playwright test",
    "coverage:merge": "node tests/merge-quality-coverage.mjs",
    "lint": "eslint src tests/quality.spec.mjs tests/merge-quality-coverage.mjs playwright.config.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.2.6",
    "streamlit-component-lib": "2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "c8": "12.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "4.2.0",
    "vite": "8.0.16",
    "v8-to-istanbul": "9.3.0",
    "istanbul-lib-coverage": "3.2.2"
  }
}
